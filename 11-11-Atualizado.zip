    public frmConsultaOS() {
    initComponents();
    setLocationRelativeTo(null);
    setTitle("AutoManager - Consulta de Ordens de Serviço");

    tblOS.setModel(new DefaultTableModel(new Object[][]{},
            new String[]{"Nº OS", "Placa", "Cliente", "ID Mecânico", "Mecânico",
                         "ID Serviço", "Serviço", "Abertura", "Status",
                         "Valor Cobrado", "Conclusão", "Diagnóstico", "Observação"}) {
        @Override
        public boolean isCellEditable(int linha, int coluna) {
            return false;
        }
    });

    tblOS.setSelectionMode(javax.swing.ListSelectionModel.SINGLE_SELECTION);

    atualizarTabela();
}
    }

