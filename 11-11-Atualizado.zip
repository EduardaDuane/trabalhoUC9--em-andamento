    private void btnAlterarActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnAlterarActionPerformed
    // 1. Linha selecionada
    int linha = tblOS.getSelectedRow();
    if (linha == -1) {
        JOptionPane.showMessageDialog(this, "Selecione uma OS na tabela para alterar.");
        return;
    }

    // 2. Valores originais (da tabela) e novo status (da tela)
    int idOS = Integer.parseInt(tblOS.getValueAt(linha, 0).toString());
    int idMecanicoAtual = Integer.parseInt(tblOS.getValueAt(linha, 3).toString());
    int idServicoAtual = Integer.parseInt(tblOS.getValueAt(linha, 5).toString());
    String statusAtual = tblOS.getValueAt(linha, 8).toString();
    String novoStatus = cmbStatus.getSelectedItem().toString();

    // 3. OS finalizada não muda mais
    if (statusAtual.equals("CONCLUIDA") || statusAtual.equals("CANCELADA")) {
        JOptionPane.showMessageDialog(this,
                "OS " + statusAtual + " não pode ser alterada.");
        return;
    }

    // 4. Respeitar o fluxo dos status
    boolean fluxoValido = novoStatus.equals(statusAtual)
        || (statusAtual.equals("ABERTA")
            && (novoStatus.equals("EM_ANDAMENTO") || novoStatus.equals("CANCELADA")))
        || (statusAtual.equals("EM_ANDAMENTO")
            && (novoStatus.equals("CONCLUIDA") || novoStatus.equals("CANCELADA")));

    if (!fluxoValido) {
        JOptionPane.showMessageDialog(this,
                "Mudança de status inválida: " + statusAtual + " → " + novoStatus + ".\n"
                + "Fluxo: ABERTA → EM_ANDAMENTO → CONCLUIDA (ou CANCELADA).");
        return;
    }

    // 5. IDs de mecânico e serviço
    int idMecanico;
    int idServico;
    try {
        idMecanico = Integer.parseInt(txtIdMecanico.getText().trim());
        idServico = Integer.parseInt(txtIdServico.getText().trim());
        if (idMecanico <= 0 || idServico <= 0) {
            JOptionPane.showMessageDialog(this, "Os IDs devem ser positivos.");
            return;
        }
    } catch (NumberFormatException erro) {
        JOptionPane.showMessageDialog(this, "Informe IDs numéricos válidos.");
        return;
    }

    // 6. Valor cobrado (não negativo)
    BigDecimal valor;
    try {
        valor = new BigDecimal(txtValor.getText().trim().replace(",", "."));
        if (valor.compareTo(BigDecimal.ZERO) < 0) {
            JOptionPane.showMessageDialog(this, "O valor cobrado não pode ser negativo.");
            return;
        }
    } catch (NumberFormatException erro) {
        JOptionPane.showMessageDialog(this, "Informe um valor cobrado válido.");
        return;
    }

    // 7. Data de conclusão
    Timestamp dataConclusao = null;
    String textoConclusao = txtDataConclusao.getText().trim();

    if (novoStatus.equals("CONCLUIDA")) {
        if (textoConclusao.isEmpty()) {
            JOptionPane.showMessageDialog(this,
                    "Informe a data de conclusão (dd/MM/aaaa HH:mm).");
            return;
        }
        try {
            LocalDateTime conclusao = LocalDateTime.parse(textoConclusao,
                    DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"));
            dataConclusao = Timestamp.valueOf(conclusao);
        } catch (DateTimeParseException erro) {
            JOptionPane.showMessageDialog(this,
                    "Data de conclusão inválida. Use dd/MM/aaaa HH:mm.");
            return;
        }
    } else if (!textoConclusao.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "A data de conclusão só deve ser preenchida ao concluir a OS.");
        return;
    }

    String diagnostico = txtDiagnostico.getText().trim();
    String observacao = txtObservacao.getText().trim();

    // 8. Confirmação
    int resposta = JOptionPane.showConfirmDialog(this,
            "Confirma a alteração da OS nº " + idOS + "?",
            "Alterar OS",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.QUESTION_MESSAGE);

    if (resposta != JOptionPane.YES_OPTION) return;

    try (Connection conexao = Conexao.conectar()) {

        // 9. Se trocou o mecânico, ele precisa existir e estar ativo
        if (idMecanico != idMecanicoAtual) {
            try (PreparedStatement busca = conexao.prepareStatement(
                    "SELECT ativo FROM mecanico WHERE id = ?")) {
                busca.setInt(1, idMecanico);
                try (ResultSet rs = busca.executeQuery()) {
                    if (!rs.next()) {
                        JOptionPane.showMessageDialog(this, "Mecânico não encontrado.");
                        return;
                    }
                    if (!rs.getBoolean("ativo")) {
                        JOptionPane.showMessageDialog(this, "Este mecânico está inativo.");
                        return;
                    }
                }
            }
        }

        // 10. Se trocou o serviço, ele precisa existir e estar ativo
        if (idServico != idServicoAtual) {
            try (PreparedStatement busca = conexao.prepareStatement(
                    "SELECT ativo FROM servico WHERE id = ?")) {
                busca.setInt(1, idServico);
                try (ResultSet rs = busca.executeQuery()) {
                    if (!rs.next()) {
                        JOptionPane.showMessageDialog(this, "Serviço não encontrado.");
                        return;
                    }
                    if (!rs.getBoolean("ativo")) {
                        JOptionPane.showMessageDialog(this, "Este serviço está inativo.");
                        return;
                    }
                }
            }
        }

        // 11. Conclusão não pode ser anterior à abertura
        if (dataConclusao != null) {
            try (PreparedStatement busca = conexao.prepareStatement(
                    "SELECT data_abertura FROM ordem_servico WHERE id = ?")) {
                busca.setInt(1, idOS);
                try (ResultSet rs = busca.executeQuery()) {
                    if (rs.next() && dataConclusao.before(rs.getTimestamp("data_abertura"))) {
                        JOptionPane.showMessageDialog(this,
                                "A data de conclusão não pode ser anterior à abertura.");
                        return;
                    }
                }
            }
        }

        // 12. UPDATE
        String sql = "UPDATE ordem_servico "
                   + "SET mecanico_id = ?, servico_id = ?, diagnostico = ?, "
                   + "status = ?, valor_cobrado = ?, observacao = ?, data_conclusao = ? "
                   + "WHERE id = ?";

        try (PreparedStatement stmt = conexao.prepareStatement(sql)) {
            stmt.setInt(1, idMecanico);
            stmt.setInt(2, idServico);
            stmt.setString(3, diagnostico.isEmpty() ? null : diagnostico);
            stmt.setString(4, novoStatus);
            stmt.setBigDecimal(5, valor);
            stmt.setString(6, observacao.isEmpty() ? null : observacao);
            stmt.setTimestamp(7, dataConclusao);
            stmt.setInt(8, idOS);

            int linhas = stmt.executeUpdate();

            JOptionPane.showMessageDialog(this,
                    linhas == 1 ? "OS alterada com sucesso!"
                                : "OS não encontrada.");

            atualizarTabela();
            limparCampos();
        }

    } catch (SQLException erro) {
        JOptionPane.showMessageDialog(this,
                "Erro ao alterar OS: " + erro.getMessage());
    }
    }//GEN-LAST:event_btnAlterarActionPerformed

    private void btnAtualizarActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnAtualizarActionPerformed
    atualizarTabela();
    limparCampos();
    txtPesquisar.setText("");
    txtDataInicial.setText("");
    txtDataFinal.setText("");
    cmbPesquisarPor.setSelectedIndex(0);
    txtPesquisar.requestFocus();

    }//GEN-LAST:event_btnAtualizarActionPerformed

    private void btnLocalizarActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnLocalizarActionPerformed
    String tipo_pesquisa = cmbPesquisarPor.getSelectedItem().toString();
    String pesquisa = txtPesquisar.getText().trim();
    int numeroOS = 0;
    LocalDate dataIni = null;
    LocalDate dataFim = null;

    // 1. Validar ANTES de mexer na tabela
    if (tipo_pesquisa.equals("Período de Abertura")) {
        DateTimeFormatter formato = DateTimeFormatter.ofPattern("dd/MM/yyyy");
        try {
            dataIni = LocalDate.parse(txtDataInicial.getText().trim(), formato);
            dataFim = LocalDate.parse(txtDataFinal.getText().trim(), formato);
        } catch (DateTimeParseException erro) {
            JOptionPane.showMessageDialog(this,
                    "Informe as datas no formato dd/MM/aaaa.");
            return;
        }
        if (dataFim.isBefore(dataIni)) {
            JOptionPane.showMessageDialog(this,
                    "A data final não pode ser anterior à inicial.");
            return;
        }
    } else {
        if (pesquisa.isEmpty()) {
            JOptionPane.showMessageDialog(this,
                    "Digite o valor que deseja pesquisar.",
                    "Pesquisa Vazia",
                    JOptionPane.WARNING_MESSAGE);
            return;
        }
        if (tipo_pesquisa.equals("Número da OS")) {
            try {
                numeroOS = Integer.parseInt(pesquisa);
            } catch (NumberFormatException erro) {
                JOptionPane.showMessageDialog(this, "Digite um número de OS válido.");
                return;
            }
        }
        if (tipo_pesquisa.equals("Placa")) {
            pesquisa = pesquisa.replace("-", "");
        }
    }

    // 2. Montar o filtro
    DefaultTableModel modelo = (DefaultTableModel) tblOS.getModel();
    modelo.setRowCount(0);

    String filtro;
    if (tipo_pesquisa.equals("Número da OS")) {
        filtro = "o.id = ? ";
    } else if (tipo_pesquisa.equals("Placa")) {
        filtro = "v.placa ILIKE ? ";
    } else if (tipo_pesquisa.equals("Cliente")) {
        filtro = "c.nome ILIKE ? ";
    } else if (tipo_pesquisa.equals("Mecânico")) {
        filtro = "m.nome ILIKE ? ";
    } else if (tipo_pesquisa.equals("Status")) {
        filtro = "o.status ILIKE ? ";
    } else {
        filtro = "CAST(o.data_abertura AS DATE) BETWEEN ? AND ? ";
    }

    String sql = SQL_BASE + "WHERE " + filtro + "ORDER BY o.id DESC";

    try (Connection conex = Conexao.conectar();
         PreparedStatement stmt = conex.prepareStatement(sql)) {

        // 3. Preencher os parâmetros (?)
        if (tipo_pesquisa.equals("Número da OS")) {
            stmt.setInt(1, numeroOS);
        } else if (tipo_pesquisa.equals("Período de Abertura")) {
            stmt.setDate(1, java.sql.Date.valueOf(dataIni));
            stmt.setDate(2, java.sql.Date.valueOf(dataFim));
        } else {
            stmt.setString(1, "%" + pesquisa + "%");
        }

        try (ResultSet rs = stmt.executeQuery()) {
            while (rs.next()) {
                modelo.addRow(new Object[]{
                    rs.getInt("id"),
                    rs.getString("placa"),
                    rs.getString("cliente_nome"),
                    rs.getInt("mecanico_id"),
                    rs.getString("mecanico_nome"),
                    rs.getInt("servico_id"),
                    rs.getString("servico_descricao"),
                    rs.getString("data_abertura"),
                    rs.getString("status"),
                    rs.getBigDecimal("valor_cobrado"),
                    rs.getString("data_conclusao"),
                    rs.getString("diagnostico"),
                    rs.getString("observacao")
                });
            }
        }

        if (modelo.getRowCount() == 0) {
            JOptionPane.showMessageDialog(this,
                    "Nenhuma ordem de serviço encontrada.",
                    "Resultado da Pesquisa",
                    JOptionPane.INFORMATION_MESSAGE);
        }
    } catch (SQLException erro) {
        JOptionPane.showMessageDialog(this,
                "Erro ao localizar OS:\n" + erro.getMessage(),
                "Erro no banco de dados",
                JOptionPane.ERROR_MESSAGE);
    
    
        
    }//GEN-LAST:event_btnLocalizarActionPerformed

    private void btnExcluirActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnExcluirActionPerformed
    int linha = tblOS.getSelectedRow();

    if (linha == -1) {
        JOptionPane.showMessageDialog(this, "Selecione uma OS para excluir.");
        return;
    }

    int idOS = Integer.parseInt(tblOS.getValueAt(linha, 0).toString());
    String statusAtual = tblOS.getValueAt(linha, 8).toString();

    if (statusAtual.equals("CONCLUIDA")) {
        JOptionPane.showMessageDialog(this, "Uma OS concluída não pode ser cancelada.");
        return;
    }
    if (statusAtual.equals("CANCELADA")) {
        JOptionPane.showMessageDialog(this, "Esta OS já está cancelada.");
        return;
    }

    int resposta = JOptionPane.showConfirmDialog(this,
            "Deseja realmente excluir a OS nº " + idOS + "?\n"
            + "Para preservar o histórico da oficina, ela será marcada como CANCELADA.",
            "Confirmar exclusão",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.WARNING_MESSAGE);

    if (resposta != JOptionPane.YES_OPTION) return;

    String sql = "UPDATE ordem_servico SET status = 'CANCELADA' "
               + "WHERE id = ? AND status IN ('ABERTA', 'EM_ANDAMENTO')";

    try (Connection conexao = Conexao.conectar();
         PreparedStatement stmt = conexao.prepareStatement(sql)) {

        stmt.setInt(1, idOS);
        int linhas = stmt.executeUpdate();

        JOptionPane.showMessageDialog(this,
                linhas == 1 ? "OS cancelada com sucesso!"
                            : "OS não encontrada ou não pode ser cancelada.");

        atualizarTabela();
        limparCampos();

    } catch (SQLException erro) {
        JOptionPane.showMessageDialog(this,
                "Erro ao cancelar OS: " + erro.getMessage());
}
    }//GEN-LAST:event_btnExcluirActionPerformed

