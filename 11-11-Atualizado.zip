    private void tblOSAncestorAdded(javax.swing.event.AncestorEvent evt) {//GEN-FIRST:event_tblOSAncestorAdded
    int linha = tblOS.getSelectedRow();
    if (linha == -1) return;

    txtNumeroOS.setText(tblOS.getValueAt(linha, 0).toString());
    txtPlaca.setText(tblOS.getValueAt(linha, 1).toString());
    txtCliente.setText(tblOS.getValueAt(linha, 2).toString());
    txtIdMecanico.setText(tblOS.getValueAt(linha, 3).toString());
    txtNomeMecanico.setText(tblOS.getValueAt(linha, 4).toString());
    txtIdServico.setText(tblOS.getValueAt(linha, 5).toString());
    txtNomeServico.setText(tblOS.getValueAt(linha, 6).toString());
    cmbStatus.setSelectedItem(tblOS.getValueAt(linha, 8).toString());
    txtValor.setText(tblOS.getValueAt(linha, 9).toString());
    txtDataConclusao.setText(tblOS.getValueAt(linha, 10).toString());
    txtDiagnostico.setText(tblOS.getValueAt(linha, 11).toString());
    txtObservacao.setText(tblOS.getValueAt(linha, 12).toString());

    }//GEN-LAST:event_tblOSAncestorAdded

    private void btnBuscarMecanicoActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnBuscarMecanicoActionPerformed
    txtNomeMecanico.setText("");
    int idMecanico;

    try {
        idMecanico = Integer.parseInt(txtIdMecanico.getText().trim());
        if (idMecanico <= 0) {
            JOptionPane.showMessageDialog(this, "Informe um ID de mecânico positivo.");
            return;
        }
    } catch (NumberFormatException erro) {
        JOptionPane.showMessageDialog(this, "Digite um ID de mecânico válido.");
        return;
    }

    String sql = "SELECT nome, ativo FROM mecanico WHERE id = ?";

    try (Connection conex = Conexao.conectar();
         PreparedStatement stmt = conex.prepareStatement(sql)) {

        stmt.setInt(1, idMecanico);

        try (ResultSet rs = stmt.executeQuery()) {
            if (rs.next()) {
                if (!rs.getBoolean("ativo")) {
                    JOptionPane.showMessageDialog(this, "Este mecânico está inativo.");
                    return;
                }
                txtNomeMecanico.setText(rs.getString("nome"));
            } else {
                JOptionPane.showMessageDialog(this, "Mecânico não encontrado.");
            }
        }
    } catch (SQLException erro) {
        JOptionPane.showMessageDialog(this,
                "Erro ao buscar mecânico: " + erro.getMessage());
    }

    }//GEN-LAST:event_btnBuscarMecanicoActionPerformed

    private void btnBuscarServicoActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_btnBuscarServicoActionPerformed
    txtNomeServico.setText("");
